// SUPMEAL - Prisma schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  EDITOR
  READER
  COMMENTER
}

enum MemberStatus {
  PENDING
  ACCEPTED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  password        String?
  firstName       String
  lastName        String
  dateOfBirth     DateTime
  avatarUrl       String?
  diet            String?
  allergies       String[]
  defaultServings Int             @default(4)
  createdAt       DateTime        @default(now())

  recipes         Recipe[]
  cookbookMembers CookbookMember[]
  comments        Comment[]
  messages        Message[]
  oauthAccounts   OAuthAccount[]
  mealPlans       MealPlan[]
  favorites       Favorite[]
}

model OAuthAccount {
  id         String @id @default(uuid())
  provider   String
  providerId String

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  @@unique([provider, providerId])
}

model Cookbook {
  id        String          @id @default(uuid())
  name      String
  createdAt DateTime        @default(now())

  members   CookbookMember[]
  recipes   Recipe[]
  messages  Message[]
  mealPlans MealPlan[]
}

model CookbookMember {
  id         String       @id @default(uuid())
  role       Role         @default(READER)
  status     MemberStatus @default(ACCEPTED)
  joinedAt   DateTime     @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  cookbook   Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  cookbookId String

  @@unique([userId, cookbookId])
}

model Recipe {
  id         String   @id @default(uuid())
  title      String
  steps      String
  prepTime   Int
  cookTime   Int
  servings   Int
  imageUrl   String?
  source     String?
  createdAt  DateTime @default(now())

  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String

  cookbook   Cookbook? @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  cookbookId String?

  ingredients Ingredient[]
  tags        Tag[]
  comments    Comment[]
  mealPlans   MealPlanRecipe[]
  favorites   Favorite[]
}

model Ingredient {
  id       String @id @default(uuid())
  name     String
  quantity String

  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String
}

model Tag {
  id      String   @id @default(uuid())
  name    String   @unique

  recipes Recipe[]
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  recipe    Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  String
}

model Message {
  id         String   @id @default(uuid())
  content    String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  cookbook   Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  cookbookId String
}

model MealPlan {
  id         String    @id @default(uuid())
  name       String
  createdAt  DateTime  @default(now())

  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String?

  cookbook   Cookbook? @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  cookbookId String?

  recipes    MealPlanRecipe[]
}

model MealPlanRecipe {
  id         String   @id @default(uuid())
  date       DateTime
  mealType   MealType?
  servings   Int?

  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  mealPlanId String

  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId   String

  @@unique([mealPlanId, recipeId, date])
}

model Favorite {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  String

  @@unique([userId, recipeId])
}
